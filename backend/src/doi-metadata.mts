import type {CatalogDraft, CatalogCreator} from './catalog-save.mts';
import type {DoiHttpErrorV1, DoiTranslationV1} from '../../../../ra-workbench-sdk/packages/workbench-backend-sdk/src/doi-metadata.js';

export const DOI_ACCEPT = 'application/vnd.datacite.datacite+json, application/vnd.crossref.unixref+xml, application/vnd.citationstyles.csl+json';
export const DOI_RESPONSE_LIMIT = 4 * 1024 * 1024;
export const HTML_RESPONSE_LIMIT = 2 * 1024 * 1024;

export type DoiMetadataError = {readonly kind: 'request' | 'parse'; readonly message: string};
export interface PreparedDoiMetadata {readonly adapter: string; readonly contentType: string; readonly body: string; readonly draft: CatalogDraft; readonly evidence: readonly {readonly kind: string; readonly value: string}[]}
export type PublisherOutcome = {readonly kind: 'html'; readonly body: string; readonly finalHttps: boolean} | {readonly kind: 'failed'; readonly error: DoiHttpErrorV1};

const text = (value: unknown): string => {
  if (typeof value === 'string') return cleanText(value);
  if (typeof value === 'number' || typeof value === 'boolean') return String(value);
  if (Array.isArray(value)) return value.find(item => typeof item === 'string') ? cleanText(String(value.find(item => typeof item === 'string'))) : '';
  return '';
};
const cleanText = (value: string): string => value.replace(/<[^>]+>/gis, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;|&apos;/g, "'").replace(/&#(x[\da-f]+|\d+);/gi, (_, raw: string) => {const n = raw.toLowerCase().startsWith('x') ? Number.parseInt(raw.slice(1), 16) : Number.parseInt(raw, 10); return Number.isFinite(n) ? String.fromCodePoint(n) : '\ufffd';}).split(/\s+/u).filter(Boolean).join(' ');
const get = (root: any, key: string): any => root && typeof root === 'object' ? root[key] : undefined;
const year = (value: any): number | null => {const parts = get(value, 'date-parts'); const n = Array.isArray(parts) && Array.isArray(parts[0]) ? Number(parts[0][0]) : Number.NaN; return Number.isInteger(n) && n >= -2147483648 && n <= 2147483647 ? n : null;};
const creators = (value: any, role: string): CatalogCreator[] => Array.isArray(value) ? value.map(entry => ({familyName: text(get(entry, 'family') ?? get(entry, 'familyName')), givenName: text(get(entry, 'given') ?? get(entry, 'givenName')), literalName: text(get(entry, 'literal') ?? get(entry, 'name')), role})).filter(entry => entry.familyName || entry.givenName || entry.literalName) : [];
const emptyDraft = (doi: string): CatalogDraft => ({id: null, itemType: 'document', title: '', abstractText: '', issuedYear: null, containerTitle: '', conferenceName: '', proceedingsTitle: '', place: '', volume: '', issue: '', pages: '', doi, url: '', language: '', bibtexKey: '', rawBibtex: null, creators: [], tags: [], sourceKind: null});

function cslType(kind: string, publisher: string): string {
  if (['journal-article', 'article-journal'].includes(kind)) return 'journalArticle';
  if (kind === 'article-magazine') return 'magazineArticle'; if (kind === 'article-newspaper') return 'newspaperArticle';
  if (['proceedings', 'proceedings-article', 'proceedings-series', 'paper-conference'].includes(kind)) return 'conferencePaper';
  if (['book', 'book-series', 'book-set', 'book-track', 'monograph', 'reference-book', 'edited-book', 'collection'].includes(kind)) return 'book';
  if (['book-chapter', 'book-part', 'book-section', 'reference-entry', 'chapter', 'content_item'].includes(kind)) return 'bookSection';
  if ((kind === 'posted-content' || kind === 'article') && publisher.toLowerCase() === 'arxiv') return 'preprint';
  if (['posted-content', 'preprint'].includes(kind)) return 'preprint'; if (['manuscript', 'peer-review'].includes(kind)) return 'manuscript';
  if (['dissertation', 'thesis'].includes(kind)) return 'thesis'; if (['report', 'report-series', 'report-component'].includes(kind)) return 'report';
  if (['dataset', 'database'].includes(kind)) return 'dataset'; if (['software', 'computer-program'].includes(kind)) return 'computerProgram';
  if (['webpage', 'post', 'post-weblog'].includes(kind)) return 'webpage'; if (kind === 'standard') return 'standard'; if (kind === 'patent') return 'patent'; return 'document';
}
function assertion(root: any, names: readonly string[]): string {const rows = get(root, 'assertion'); if (!Array.isArray(rows)) return ''; const row = rows.find(item => names.some(name => text(get(item, 'name')).toLowerCase() === name.toLowerCase())); return text(get(row, 'value'));}

function parseCsl(doi: string, body: string): {draft: CatalogDraft; evidence: {kind: string; value: string}[]} {
  let root: any; try {root = JSON.parse(body);} catch (error) {return fail(`DOI JSON 元数据格式无效：${error}`);}
  const kind = text(get(root, 'type')); const publisher = text(get(root, 'publisher')); let itemType = cslType(kind, publisher); const event = get(root, 'event');
  let conference = text(get(root, 'event-title')) || text(get(event, 'name')) || assertion(root, ['conference_name', 'conference_acronym', 'conference_id']);
  const evidence: {kind: string; value: string}[] = itemType === 'conferencePaper' ? [{kind: 'doi-format', value: kind}] : [];
  if ((itemType === 'bookSection' || itemType === 'document') && conference) {itemType = 'conferencePaper'; evidence.push({kind: 'crossref-event-or-assertion', value: conference});}
  const container = text(get(root, 'container-title')); const creatorsList = [['author', 'author'], ['editor', 'editor'], ['translator', 'translator'], ['container-author', 'bookAuthor'], ['collection-editor', 'seriesEditor']] as const;
  const allCreators = creatorsList.flatMap(([field, role]) => creators(get(root, field), role));
  const tags = text(get(root, 'keyword')).split(/[,;]/u).map(v => v.trim()).filter(Boolean);
  const draft = emptyDraft(doi); Object.assign(draft, {itemType, title: text(get(root, 'title')), abstractText: text(get(root, 'abstract')), issuedYear: year(get(root, 'issued')) ?? year(get(root, 'published')) ?? year(get(root, 'published-print')), containerTitle: itemType === 'conferencePaper' ? '' : container, conferenceName: conference, proceedingsTitle: itemType === 'conferencePaper' ? container : '', place: text(get(root, 'event-place')) || text(get(event, 'location')) || assertion(root, ['conference_location']), volume: text(get(root, 'volume')), issue: text(get(root, 'issue')), pages: text(get(root, 'page')), url: text(get(root, 'URL') ?? get(root, 'url')), language: text(get(root, 'language')), creators: allCreators, tags, sourceKind: `doi.org:${adapterFor(body)}`});
  return {draft, evidence};
}

function dataCiteType(types: any): string {const citeproc = text(get(types, 'citeproc')); const map: Record<string, string> = {article: 'preprint', book: 'book', chapter: 'bookSection', 'article-journal': 'journalArticle', 'article-magazine': 'magazineArticle', 'article-newspaper': 'newspaperArticle', 'paper-conference': 'conferencePaper', manuscript: 'manuscript', thesis: 'thesis', report: 'report', dataset: 'dataset', webpage: 'webpage', 'post-weblog': 'webpage', patent: 'patent'}; let out = map[citeproc] ?? 'journalArticle'; const schema = text(get(types, 'schemaOrg')).toLowerCase(); if (['softwaresourcecode', 'softwareapplication', 'mobileapplication', 'videogame', 'webapplication'].includes(schema)) out = 'computerProgram'; if (text(get(types, 'resourceTypeGeneral')) === 'BookChapter') out = 'bookSection'; return out;}
function dataCiteTitle(attributes: any): string {const titles = get(attributes, 'titles'); if (!Array.isArray(titles)) return ''; let title = ''; let alternate = ''; for (const entry of titles) {const value = text(get(entry, 'title')); if (!value) continue; const kind = text(get(entry, 'titleType')); if (!kind) title += value; else if (kind.toLowerCase() === 'subtitle') title += `: ${value}`; else if (!alternate) alternate = value;} return title || alternate;}
function parseDataCite(doi: string, body: string): {draft: CatalogDraft; evidence: {kind: string; value: string}[]} {let root: any; try {root = JSON.parse(body);} catch (error) {return fail(`DataCite JSON 格式无效：${error}`);} const attributes = get(get(root, 'data'), 'attributes') ?? root; const types = get(attributes, 'types') ?? {}; const itemType = dataCiteType(types); const published = Array.isArray(get(attributes, 'relatedItems')) ? get(attributes, 'relatedItems').find((item: any) => text(get(item, 'relationType')) === 'IsPublishedIn') : undefined; const container = published ?? get(attributes, 'container'); const dateRows = get(attributes, 'dates'); let issuedYear: number | null = null; for (const wanted of ['Issued', 'Updated', 'Available', 'Accepted', 'Submitted', 'Created']) {const row = Array.isArray(dateRows) ? dateRows.find((entry: any) => text(get(entry, 'dateType')).toLowerCase() === wanted.toLowerCase()) : undefined; const n = Number(text(get(row, 'date')).slice(0, 4)); if (Number.isInteger(n)) {issuedYear = n; break;}} issuedYear ??= Number(text(get(attributes, 'publicationYear'))) || null; const allCreators = (Array.isArray(get(attributes, 'creators')) ? get(attributes, 'creators') : []).map((entry: any) => ({familyName: text(get(entry, 'familyName')), givenName: text(get(entry, 'givenName')), literalName: text(get(entry, 'name')), role: 'author'})); const contributors = (Array.isArray(get(attributes, 'contributors')) ? get(attributes, 'contributors') : []).map((entry: any) => ({familyName: text(get(entry, 'familyName')), givenName: text(get(entry, 'givenName')), literalName: text(get(entry, 'name')), role: text(get(entry, 'contributorType')).toLowerCase() === 'editor' ? 'editor' : text(get(entry, 'contributorType')).toLowerCase() === 'producer' ? 'producer' : 'contributor'})); const tags = (Array.isArray(get(attributes, 'subjects')) ? get(attributes, 'subjects') : []).map((entry: any) => text(get(entry, 'subject'))).filter(Boolean); const first = text(get(container, 'firstPage')); const last = text(get(container, 'lastPage')); const pages = first && last && first !== last ? `${first}-${last}` : first || last || (Array.isArray(get(attributes, 'sizes')) ? get(attributes, 'sizes').map(text).join(', ') : ''); const draft = emptyDraft(doi); Object.assign(draft, {itemType, title: dataCiteTitle(attributes), abstractText: (Array.isArray(get(attributes, 'descriptions')) ? get(attributes, 'descriptions').find((entry: any) => text(get(entry, 'descriptionType')).toLowerCase() === 'abstract') : undefined) ? text(get((get(attributes, 'descriptions').find((entry: any) => text(get(entry, 'descriptionType')).toLowerCase() === 'abstract')), 'description')) : '', issuedYear, containerTitle: container ? text(get(container, 'title')) || text(get(container, 'titles')?.[0]?.title) : '', volume: text(get(container, 'volume')), issue: text(get(container, 'issue')), pages, url: text(get(attributes, 'url')), language: text(get(attributes, 'language')), creators: [...allCreators, ...contributors], tags, sourceKind: `doi.org:${adapterFor(body)}`}); return {draft, evidence: itemType === 'conferencePaper' ? [{kind: 'doi-format', value: `${text(get(types, 'resourceTypeGeneral'))} ${text(get(types, 'resourceType'))}`.trim()}] : []};}

type XmlLeaf = {path: string; text: string};
function xmlLeaves(body: string): XmlLeaf[] {const leaves: XmlLeaf[] = []; const stack: {name: string; text: string}[] = []; const re = /<!--[\s\S]*?-->|<([\w:-]+)(?:\s+[^>]*?)?\/?>|<\/([\w:-]+)>|([^<]+)/g; let match: RegExpExecArray | null; while ((match = re.exec(body))) {if (match[0].startsWith('<!--')) continue; if (match[1] && !match[0].endsWith('/>')) stack.push({name: match[1].toLowerCase().split(':').pop() ?? '', text: ''}); else if (match[2]) {const value = cleanText(stack.pop()?.text ?? ''); if (value) leaves.push({path: stack.concat([{name: match[2].toLowerCase().split(':').pop() ?? '', text: ''}]).map(x => x.name).join('/'), text: value});} else if (match[3] && stack.length) stack[stack.length - 1]!.text += match[3];} return leaves;}
function parseCrossref(doi: string, body: string): {draft: CatalogDraft; evidence: {kind: string; value: string}[]} {const leaves = xmlLeaves(body); const lower = body.toLowerCase(); const leaf = (...suffixes: string[]) => suffixes.map(suffix => leaves.find(item => item.path.endsWith(suffix))).find(Boolean)?.text ?? ''; const conferenceExplicit = lower.includes('<conference') || lower.includes('<proceedings_'); const hasContent = lower.includes('<content_item'); let itemType = conferenceExplicit ? 'conferencePaper' : lower.includes('<journal_article') ? 'journalArticle' : lower.includes('<dissertation') ? 'thesis' : lower.includes('<report-paper') ? 'report' : lower.includes('<standard') ? 'standard' : lower.includes('<book') && hasContent ? 'bookSection' : lower.includes('<book') ? 'book' : 'document'; const conference = conferenceExplicit ? leaf('conference_name', 'event_metadata/conference_name') : leaf('assertion/conference_name', 'assertion/conference_acronym', 'assertion/conference_id'); const evidence: {kind: string; value: string}[] = conferenceExplicit ? [{kind: 'crossref-unixref-conference', value: conference}] : []; if ((itemType === 'bookSection' || itemType === 'document') && conference) {itemType = 'conferencePaper'; evidence.push({kind: 'crossref-event-or-assertion', value: conference});} const people: CatalogCreator[] = []; const personRe = /<person_name[^>]*contributor_role=["']([^"']+)["'][^>]*>[\s\S]*?<given_name>([\s\S]*?)<\/given_name>[\s\S]*?<surname>([\s\S]*?)<\/surname>[\s\S]*?<\/person_name>/gi; let p: RegExpExecArray | null; while ((p = personRe.exec(body))) people.push({familyName: cleanText(p[3]!), givenName: cleanText(p[2]!), literalName: '', role: p[1]!}); const draft = emptyDraft(doi); Object.assign(draft, {itemType, title: leaf('content_item/titles/title', 'journal_article/titles/title', 'conference_paper/titles/title'), abstractText: leaf('abstract', 'jats/abstract'), issuedYear: Number(leaf('publication_date/year', 'conference_date/year')) || null, containerTitle: itemType === 'conferencePaper' ? '' : leaf('book_metadata/titles/title', 'book_series_metadata/titles/title', 'journal_metadata/full_title'), conferenceName: conference, proceedingsTitle: itemType === 'conferencePaper' ? leaf('book_metadata/titles/title', 'proceedings_metadata/proceedings_title') : '', place: leaf('conference_location', 'assertion/conference_location', 'publisher_place'), volume: leaf('journal_volume/volume', 'volume'), issue: leaf('journal_issue/issue', 'issue'), pages: (() => {const first = leaf('pages/first_page'); const last = leaf('pages/last_page'); return first && last && first !== last ? `${first}-${last}` : first;})(), url: leaf('resource'), creators: people, sourceKind: `doi.org:${adapterFor(body)}`}); return {draft, evidence};}

function adapterFor(body: string): string {const lower = body.toLowerCase(); return lower.includes('<crossref') ? 'crossref-unixref-xml' : lower.includes('http://datacite.org/schema') || lower.includes('"agency"') || lower.includes('"providerid"') || lower.includes('"resourcetypegeneral"') ? 'datacite-json' : 'csl-json';}
function fail(message: string): never {throw Object.assign(new Error(message), {kind: 'parse'});}
function bodyError(error: DoiHttpErrorV1, label: string): DoiMetadataError {switch (error.kind) {case 'invalidResolver': case 'client': case 'send': return {kind: 'request', message: error.cause}; case 'notFound': return {kind: 'request', message: '没有找到 DOI 元数据，请检查 DOI 是否正确'}; case 'status': return {kind: 'request', message: `${label}返回错误：${error.cause}`}; case 'tooLarge': return {kind: 'request', message: `${label}响应超过大小限制`}; case 'read': return {kind: 'request', message: `无法读取${label}响应：${error.cause}`}; case 'utf8': return {kind: 'parse', message: `${label}响应不是 UTF-8：${error.cause}`};}}
export function resolverError(error: DoiHttpErrorV1): DoiMetadataError {return error.kind === 'invalidResolver' ? {kind: 'request', message: `DOI resolver 地址无效：${error.cause}`} : error.kind === 'send' ? {kind: 'request', message: `无法连接 DOI resolver：${error.cause}`} : bodyError(error, 'DOI resolver ');}
export function prepareDoi(normalizedDoi: string, contentType: string, body: string): PreparedDoiMetadata {const adapter = adapterFor(body); const parsed = adapter === 'crossref-unixref-xml' ? parseCrossref(normalizedDoi, body) : adapter === 'datacite-json' ? parseDataCite(normalizedDoi, body) : parseCsl(normalizedDoi, body); const draft = parsed.draft.title ? parsed.draft : {...parsed.draft, title: normalizedDoi}; return {adapter, contentType, body, draft, evidence: parsed.evidence};}
export function needsPublisher(prepared: PreparedDoiMetadata): boolean {return prepared.draft.itemType === 'bookSection' || prepared.draft.itemType === 'document' || prepared.evidence.some(entry => entry.kind === 'crossref-event-or-assertion');}
function embeddedMetadata(html: string): Record<string, string> {const result: Record<string, string> = {}; const re = /<meta\b[^>]*?(?:name|property)=["']([^"']+)["'][^>]*?content=["']([^"']*)["'][^>]*>/gi; let m: RegExpExecArray | null; while ((m = re.exec(html))) result[m[1]!.toLowerCase()] ??= cleanText(m[2]!); return result;}
export function finishDoi(prepared: PreparedDoiMetadata, publisher: PublisherOutcome | null): DoiTranslationV1 {const need = needsPublisher(prepared); if (need !== Boolean(publisher) || (publisher?.kind === 'failed' && ['invalidResolver', 'client'].includes(publisher.error.kind))) throw Object.assign(new Error('DOI 出版商补充结果与准备状态不符'), {kind: 'parse'}); const draft = {...prepared.draft, creators: [...prepared.draft.creators]}; const warnings: string[] = []; const metadata: Record<string, string> = {}; if (publisher?.kind === 'html' && publisher.finalHttps) {Object.assign(metadata, embeddedMetadata(publisher.body)); const conference = metadata.citation_conference_title || metadata.citation_conference || ''; if ((draft.itemType === 'bookSection' || draft.itemType === 'document') && conference) {draft.itemType = 'conferencePaper'; draft.conferenceName = conference; draft.proceedingsTitle = metadata.citation_inbook_title || metadata.citation_book_title || draft.containerTitle; draft.containerTitle = ''; } if (draft.itemType === 'conferencePaper') {draft.conferenceName ||= conference; draft.proceedingsTitle ||= metadata.citation_inbook_title || metadata.citation_book_title || ''; draft.place ||= metadata.citation_conference_location || metadata.citation_publisher_place || ''; }} else if (publisher?.kind === 'html') warnings.push('出版商页面不是 HTTPS，已保留 DOI 基础元数据'); else if (publisher?.kind === 'failed') warnings.push(`出版商页面补充失败：${bodyError(publisher.error, '出版商页面').message}；已保留 DOI 基础元数据`); if (draft.itemType === 'document') warnings.push('文献类型缺少明确会议证据，请人工确认'); const rawPayload = JSON.stringify({schemaVersion: 1, adapter: prepared.adapter, contentType: prepared.contentType, doiResponse: prepared.body, embeddedMetadata: metadata, typeEvidence: prepared.evidence, warnings}); return {draft, rawPayload, sourceKind: `doi.org:${prepared.adapter}`, warnings};}
