function pageAnchor(attachmentId: string, sha256: string, pageIndex: bigint, quote: string): string {return `ai-overview-${createHash('sha256').update(`${PAGE_EVIDENCE_CONFIG_VERSION}:${attachmentId}:${sha256}:${pageIndex}:${quote}`).digest('hex')}`;}
