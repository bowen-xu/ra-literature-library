export function selectionPreview(source: AnchorEvidence | null): {Ok: readonly AiEvidencePreview[]} | {Err: AnalysisWorkflowError} {if (source === null) return {Err: invalid('原文锚点或对应附件版本已不可用')}; if (source.quoteExact.trim() === '') return {Err: invalid('AI 选区解释要求非空的精确原文引用')}; if ([...source.quoteExact].length > 1500) return {Err: invalid('AI 选区 quote 超过 1,500 字符；请缩短选区后重新预览')}; const context = source.quotePrefix + source.quoteExact + source.quoteSuffix; if ([...context].length > 12000) return {Err: invalid('AI 选区 context 超过 12,000 字符；请缩小来源范围后重新预览')}; const base = {anchorId: source.anchorId, paperTitle: source.paperTitle, attachmentId: source.attachmentId, contentSha256: source.contentSha256, pageIndex: source.pageIndex, pageLabel: source.pageLabel, quoteExact: source.quoteExact}; return {Ok: [{...base, citationKey: 'ev-quote', contextText: source.quoteExact, relationKind: 'direct_quote'}, {...base, citationKey: 'ev-context', contextText: context, relationKind: 'context'}]};}
