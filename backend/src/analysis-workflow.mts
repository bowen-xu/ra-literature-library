export function decideTemplate(input: TemplateInputV1): TemplateDecisionV1 {try {if (input.kind === 'legacyAvailability') return input.managedResources ? {kind: 'rejected', error: {kind: 'invalidInput', message: '旧画像模板标识仅用于历史读取；请先确认或采用已发布的资源模板，再开始新提取'}} : {kind: 'verified'}; const [id, revision] = referenceIdentity(input.reference); if (input.kind === 'legacyIdentity') return input.latest !== null && input.latest[0] === id && input.latest[1] === revision ? {kind: 'verified'} : {kind: 'rejected', error: {kind: 'invalidInput', message: '本文画像模板不可用或已有新版本，请重新载入'}}; if (input.kind === 'resourceBinding') {if (input.binding === null) return {kind: 'rejected', error: {kind: 'invalidInput', message: '请先采用阅读模板'}}; return input.binding[0] === id && input.binding[1] === revision ? {kind: 'verified'} : {kind: 'rejected', error: {kind: 'invalidInput', message: '本文采用的模板版本已变化，请重新载入'}};} if (input.kind === 'legacyContent') {if (input.currentRevision !== revision || input.evidence.length === 0 || input.evidence.some(source => source.paperId !== input.paperId || source.currentAnchorStatus === 'stale' || source.currentAnchorStatus === 'missing')) return {kind: 'rejected', error: {kind: 'invalidInput', message: '画像来源已失效或不属于当前文献，请重新核对'}}; const row = input.revisions.find(item => item.revision === revision); if (row === undefined) return {kind: 'rejected', error: {kind: 'temporaryUnavailable'}}; const fields = (row.payload as any)?.template; if (!Array.isArray(fields)) return {kind: 'rejected', error: {kind: 'temporaryUnavailable'}}; return {kind: 'resolved', profile: templateProfile(input.paperId, revision, input.reference, fields)};} const raw = JSON.parse(input.raw); const fields = raw?.fields; if (!Array.isArray(fields)) return {kind: 'rejected', error: {kind: 'invalidInput', message: '阅读模板字段无效'}}; return {kind: 'resolved', profile: templateProfile(input.paperId, input.selectionRevision, input.reference, fields)};} catch {return {kind: 'rejected', error: {kind: 'temporaryUnavailable'}};}}
const pageKeywords = ['abstract', 'research question', 'objective', 'purpose', 'method', 'methods', 'approach', 'experiment', 'participants', 'dataset', 'result', 'results', 'finding', 'findings', 'conclusion', 'conclusions', 'discussion', 'limitation', 'limitations', 'future work', '摘要', '研究问题', '方法', '实验', '结果', '结论', '局限', '未来工作'];
function pageScore(index: bigint, value: string): number {const lower = value.toLowerCase(); return pageKeywords.filter(keyword => lower.includes(keyword)).length * 10 + (index === 0n ? 25 : 0) + (index === 1n ? 10 : 0);}
function pageExcerpt(value: string): readonly [string, string, string] {const chars = [...value]; const lower = value.toLowerCase(); const positions = pageKeywords.map(keyword => lower.indexOf(keyword)).filter(position => position >= 0); const hit = positions.length === 0 ? 0 : [...value.slice(0, Math.min(...positions))].length; const start = Math.max(0, hit - 160); const end = Math.min(chars.length, start + 1200); return [chars.slice(Math.max(0, start - 160), start).join(''), chars.slice(start, end).join('').trim(), chars.slice(end, Math.min(chars.length, end + 160)).join('')];}
