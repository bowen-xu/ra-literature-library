function candidateKindAllowed(taskKind: string, suggestionKind: string | null, candidateKind: string): boolean {switch (taskKind) {case 'paper_profile_classification': return candidateKind === 'paper_portrait_v1'; case 'selection_explanation': return candidateKind === 'selection_explanation_v1'; case 'paper_overview': return candidateKind === 'paper_overview_unit_v1'; case 'paper_concept_map': return candidateKind === 'paper_concept_map_v1'; case 'paper_suggestions': return suggestionKind === candidateKind; case 'reference_extraction': return candidateKind === 'reference_record_candidate_v1'; case 'matrix_synthesis': return candidateKind === 'derived_research_view_v1'; default: return false;}}
function candidateEvidenceValid(payload: any, evidence: readonly {readonly citationKey: string}[]): boolean {const allowed = new Set(evidence.map(item => item.citationKey)); return candidatePayloadCitationReferences(payload).every(reference => reference.evidenceItemIds.every(id => allowed.has(id)));}
const candidateJson = (value: unknown): string => JSON.stringify(value, (_key, current: unknown) => typeof current === 'bigint' ? Number(current) : current);
function candidateProfileValid(payload: any, profile: any): boolean {if (candidatePayloadKind(payload) !== 'paper_overview_unit_v1') return true; const overview = payload.PaperOverview; const fields = overview.fields.map((field: any) => field.field); if (profile === null) return overview.profileId === 'generic_overview_v1' && (overview.profileRefs === null || overview.profileRefs === undefined) && fields.every((field: string, index: number) => field === GENERIC_OVERVIEW_FIELDS[index]) && fields.length === GENERIC_OVERVIEW_FIELDS.length; const template = profile.paperTemplate; if (template !== null) return overview.profileId === 'paper_template_v1' && overview.paperTemplate !== null && JSON.stringify(overview.paperTemplate) === JSON.stringify(template) && (overview.profileRefs === null || overview.profileRefs === undefined) && JSON.stringify(fields) === JSON.stringify(profile.fieldKinds); return overview.paperTemplate === null && overview.profileId === 'reviewed_profile_composition_v1' && JSON.stringify(overview.profileRefs ?? []) === JSON.stringify(profile.profileRefs) && JSON.stringify(fields) === JSON.stringify(profile.fieldKinds);}
export function decideCandidate(input: CandidateInputV1): CandidateDecisionV1 {try {if (input.kind === 'decode') return {kind: 'decoded', payloadCborBase64: encodePayload(decodeCandidateJson(input.content, input.evidenceKeys), CandidatePayloadSerde)}; const payload = decodePayload(input.payloadCborBase64, CandidatePayloadSerde); const kind = candidatePayloadKind(payload); if (input.kind === 'kindAndQuotes') return candidateKindAllowed(input.taskKind, input.suggestionKind, kind) && candidateEvidenceValid(payload, input.evidence) ? {kind: 'validated'} : candidateError('provider 候选类型与冻结的任务输出类型不一致'); if (input.kind === 'profile') return candidateProfileValid(payload, input.profile) ? {kind: 'validated'} : candidateError('论文概要字段或画像版本与本次运行冻结的上下文不一致'); if (input.kind === 'finalize') {if (input.matrix !== null && kind !== 'derived_research_view_v1') return candidateError('派生视图类型或标题与冻结的矩阵综合上下文不一致'); const inner = (payload as any)[Object.keys(payload as any)[0]!]; return {kind: 'prepared', canonicalJson: candidateJson(inner)};} if (input.kind === 'revisionQuotesAndKind') return candidateKindAllowed('paper_overview', null, kind) && candidateEvidenceValid(payload, input.evidence) && kind === input.candidateKind ? {kind: 'validated'} : candidateError('候选修订不能改变候选类型'); if (input.kind === 'revisionMatrix') return input.matrix === null || kind === 'derived_research_view_v1' ? {kind: 'validated'} : candidateError('派生视图类型或标题与冻结的矩阵综合上下文不一致'); const inner = (payload as any)[Object.keys(payload as any)[0]!]; return {kind: 'prepared', canonicalJson: candidateJson(inner)};} catch (error) {return candidateError(error instanceof Error ? error.message : '结构化内容无效');}}
