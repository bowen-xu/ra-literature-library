export function decideCandidate(input: CandidateInputV1): CandidateDecisionV1 {try {if (input.kind === 'decode') return {kind: 'decoded', payloadCborBase64: encodePayload(decodeCandidateJson(input.content, input.evidenceKeys), CandidatePayloadSerde)}; const payload = decodePayload(input.payloadCborBase64, CandidatePayloadSerde); const kind = candidatePayloadKind(payload); if (input.kind === 'kindAndQuotes') return candidateKindAllowed(input.taskKind, input.suggestionKind, kind) && candidateEvidenceValid(payload, input.evidence) ? {kind: 'validated'} : candidateError('provider 候选类型与冻结的任务输出类型不一致'); if (input.kind === 'profile') return candidateProfileValid(payload, input.profile) ? {kind: 'validated'} : candidateError('论文概要字段或画像版本与本次运行冻结的上下文不一致'); if (input.kind === 'finalize') {if (input.matrix !== null && kind !== 'derived_research_view_v1') return candidateError('派生视图类型或标题与冻结的矩阵综合上下文不一致'); const inner = (payload as any)[Object.keys(payload as any)[0]!]; return {kind: 'prepared', canonicalJson: candidateJson(inner)};} if (input.kind === 'revisionQuotesAndKind') return candidateKindAllowed('paper_overview', null, kind) && candidateEvidenceValid(payload, input.evidence) && kind === input.candidateKind ? {kind: 'validated'} : candidateError('候选修订不能改变候选类型'); if (input.kind === 'revisionMatrix') return input.matrix === null || kind === 'derived_research_view_v1' ? {kind: 'validated'} : candidateError('派生视图类型或标题与冻结的矩阵综合上下文不一致'); const inner = (payload as any)[Object.keys(payload as any)[0]!]; return {kind: 'prepared', canonicalJson: candidateJson(inner)};} catch (error) {return candidateError(error instanceof Error ? error.message : '结构化内容无效');}}
