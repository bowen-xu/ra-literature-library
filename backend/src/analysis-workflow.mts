;}}
const pageKeywords = ['abstract', 'research question', 'objective', 'purpose', 'method', 'methods', 'approach', 'experiment', 'participants', 'dataset', 'result', 'results', 'finding', 'findings', 'conclusion', 'conclusions', 'discussion', 'limitation', 'limitations', 'future work', '摘要', '研究问题', '方法', '实验', '结果', '结论', '局限', '未来工作'];
function pageScore(index: bigint, value: string): number {const lower = value.toLowerCase(); return pageKeywords.filter(keyword => lower.includes(keyword)).length * 10 + (index === 0n ? 25 : 0) + (index === 1n ? 10 : 0);}
function pageExcerpt(value: string): readonly [string, string, string] {const chars = [...value]; const lower = value.toLowerCase(); const positions = pageKeywords.map(keyword => lower.indexOf(keyword)).filter(position => position >= 0); const hit = positions.length === 0 ? 0 : [...value.slice(0, Math.min(...positions))].length; const start = Math.max(0, hit - 160); const end = Math.min(chars.length, start + 1200); return [chars.slice(Math.max(0, start - 160), start).join(''), chars.slice(start, end).join('').trim(), chars.slice(end, Math.min(chars.length, end + 160)).join('')];}
function pageAnchor(attachmentId: string, sha256: string, pageIndex: bigint, quote: string): string {return `ai-overview-${createHash('sha256').update(`${PAGE_EVIDENCE_CONFIG_VERSION}:${attachmentId}:${sha256}:${pageIndex}:${quote}`).digest('hex')}`;}
function pageCitation(ordinal: number): string {return `ev-page-${ordinal + 1}`;}
function previewPages(sources: readonly OverviewPageEvidence[]): readonly AiEvidencePreview[] {return sources.map((source, ordinal) => ({citationKey: pageCitation(ordinal), anchorId: source.anchorId, paperTitle: source.paperTitle, attachmentId: source.attachmentId, contentSha256: source.contentSha256, pageIndex: source.pageIndex, pageLabel: String(Number(source.pageIndex) + 1), quoteExact: source.quoteExact, contextText: source.quotePrefix + source.quoteExact + source.quoteSuffix, relationKind: 'direct_quote'}));}
export function selectPages(attachment: AttachmentEvidence, attachmentId: string, pages: readonly (readonly [bigint, string])[]): {ok: true; sources: readonly OverviewPageEvidence[]} | {ok: false; error: AnalysisWorkflowError} {if (pages.length === 0) return {ok: false, error: invalid('PDF 页文本索引为空，无法建立可核验概要')}; const ranked = pages.map(([index, text]) => ({index, text, score: pageScore(index, text)})).sort((a, b) => b.score - a.score || Number(a.index - b.index)).slice(0, 10).sort((a, b) => Number(a.index - b.index)); return {ok: true, sources: ranked.map(({index, text}) => {const [prefix, quote, suffix] = pageExcerpt(text); return {anchorId: pageAnchor(attachmentId, attachment.contentSha256, index, quote), paperId: attachment.paperId, paperTitle: attachment.paperTitle, attachmentId, contentSha256: attachment.contentSha256, pageIndex: index, quoteExact: quote, quotePrefix: prefix, quoteSuffix: suffix};})};}
export function selectionPreview(source: AnchorEvidence | null): {Ok: readonly AiEvidencePreview[]} | {Err: AnalysisWorkflowError} {if (source === null) return {Err: invalid('原文锚点或对应附件版本已不可用')}; if (source.quoteExact.trim() === '') return {Err: invalid('AI 选区解释要求非空的精确原文引用')}; if ([...source.quoteExact].length > 1500) return {Err: invalid('AI 选区 quote 超过 1,500 字符；请缩短选区后重新预览')}; const context = source.quotePrefix + source.quoteExact + source.quoteSuffix; if ([...context].length > 12000) return {Err: invalid('AI 选区 context 超过 12,000 字符；请缩小来源范围后重新预览')}; const base = {anchorId: source.anchorId, paperTitle: source.paperTitle, attachmentId: source.attachmentId, contentSha256: source.contentSha256, pageIndex: source.pageIndex, pageLabel: source.pageLabel, quoteExact: source.quoteExact}; return {Ok: [{...base, citationKey: 'ev-quote', contextText: source.quoteExact, relationKind: 'direct_quote'}, {...base, citationKey: 'ev-context', contextText: context, relationKind: 'context'}]};}
export function overviewTask(input: OverviewTaskInputV1): string {const draft = {taskKind: 'paper_overview', providerId: '', modelSelection: input.modelSelection, userGoal: '按用户确认的阅读框架，从 Docling 结构化上下文中逐字段提取候选，并为每条原子陈述引用结构化块 ID。', pipelineVersion: 'paper-overview-docling-runtime-v1', promptVersion: 'paper-overview-docling-context-v3', outputSchemaVersion: 1n, maxInputTokens: 64000n, maxOutputTokens: 4000n, timeoutMs: 120000n, scopeItems: input.attachmentIds.map(objectId => ({itemKind: 'attachment', objectId, parentObjectId: input.paperId, contentSha256: null, objectRevision: null})), overviewFields: [], overviewProfileSelectionRevision: input.template === null ? input.selectionRevision : null, paperTemplateRef: input.template, suggestionCandidateKind: null, matrixSynthesisContext: null, baseCandidateId: null, baseCandidateRevision: null, confirmedScopeHash: null, cloudConsentVersion: null}; return encodePayload(draft, AiTaskSpecDraftSerde);}
