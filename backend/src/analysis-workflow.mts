function candidateKindAllowed(taskKind: string, suggestionKind: string | null, candidateKind: string): boolean {switch (taskKind) {case 'paper_profile_classification': return candidateKind === 'paper_portrait_v1'; case 'selection_explanation': return candidateKind === 'selection_explanation_v1'; case 'paper_overview': return candidateKind === 'paper_overview_unit_v1'; case 'paper_concept_map': return candidateKind === 'paper_concept_map_v1'; case 'paper_suggestions': return suggestionKind === candidateKind; case 'reference_extraction': return candidateKind === 'reference_record_candidate_v1'; case 'matrix_synthesis': return candidateKind === 'derived_research_view_v1'; default: return false;}}
function candidateEvidenceValid(payload: any, evidence: readonly {readonly citationKey: string}[]): boolean {const allowed = new Set(evidence.map(item => item.citationKey)); return candidatePayloadCitationReferences(payload).every(reference => reference.evidenceItemIds.every(id => allowed.has(id)));}
