const pageKeywords = ['abstract', 'research question', 'objective', 'purpose', 'method', 'methods', 'approach', 'experiment', 'participants', 'dataset', 'result', 'results', 'finding', 'findings', 'conclusion', 'conclusions', 'discussion', 'limitation', 'limitations', 'future work', '摘要', '研究问题', '方法', '实验', '结果', '结论', '局限', '未来工作'];
function pageScore(index: bigint, value: string): number {const lower = value.toLowerCase(); return pageKeywords.filter(keyword => lower.includes(keyword)).length * 10 + (index === 0n ? 25 : 0) + (index === 1n ? 10 : 0);}
